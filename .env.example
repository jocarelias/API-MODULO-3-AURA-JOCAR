# ============================================================
# G3 — Avaliações e Horários · exemplo de configuração de ambiente
# Copie para .env e ajuste os valores. Nunca commite o .env.
# ============================================================

NODE_ENV=development

# --- Banco de dados (PostgreSQL via Docker, porta 5434) ---
# `docker compose up -d` cria o banco `smartcampos`.
DATABASE_URL=postgresql://smartcampos:smartcampos@localhost:5434/smartcampos?schema=public

# --- Servidor ---
G3_PORT=4100

# --- API Client (@smartcampus/api-client) ---
G3_API_URL=http://localhost:4100