# ============================================================
# Smart Campos Core API - exemplo de configuracao de ambiente
# Copie para .env e ajuste os valores. Nunca commite o .env.
# ============================================================

NODE_ENV=development
PORT=3000

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://smartcampos:smartcampos@localhost:5434/smartcampos?schema=public

# URL usada em testes e2e (schema/banco de teste)
DATABASE_URL_TEST=postgresql://smartcampos:smartcampos@localhost:5434/smartcampos_test?schema=public

# --- Autenticao JWT ---
# IMPORTANTE: gerar valores fortes em producao.
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=mude-este-segredo-de-acesso
JWT_REFRESH_SECRET=mude-este-segredo-de-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seguranca / Limites ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
BODY_LIMIT=1mb

# --- Logging ---
LOG_LEVEL=info

# --- Seed ---
SEED_ADMIN_EMAIL=admin@smartcampos.local
SEED_ADMIN_PASSWORD=Admin@123