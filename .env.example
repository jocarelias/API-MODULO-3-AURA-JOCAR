# ============================================================
# G3 — Avaliações e Horários · exemplo de configuração de ambiente
# ============================================================

NODE_ENV=development

# --- Banco de dados (PostgreSQL via Docker, porta 5434) ---
# `docker compose up -d` cria o banco `smartcampos`.
DATABASE_URL=postgresql://smartcampos:smartcampos@localhost:5434/smartcampos?schema=public

# --- Servidor ---
G3_PORT=4100

# --- Autenticação (JWT) ---
# Segredo usado para assinar/verificar accessTokens emitidos pela API do G3.
# Fallback: SMARTCAMPUS_JWT_SECRET (usado também como contrato partilhado com os serviços Core).
JWT_ACCESS_SECRET=change-me-access
# Segredo usado para assinar/verificar refreshTokens (rotação + revogação). Fallback: SMARTCAMPUS_JWT_SECRET.
JWT_REFRESH_SECRET=change-me-refresh
# Duração dos tokens (s|m|h|d). Don't use "15m"/"7d" como no produção.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Segredo legado partilhado com os serviços Core (students/teachers/enrolments/finance).
SMARTCAMPUS_JWT_SECRET=change-me

# --- Contratos com o módulo Financeiro ---
# Credencial de serviço que o G3 usa para falar com o Finance (NUCA o token do aluno).
FINANCIAL_SERVICE_TOKEN=change-me
# Fallback alternativo (mesma finalidade).
SMARTCAMPUS_SERVICE_TOKEN=change-me

# --- URLs dos serviços Core (contratos HTTP) ---
STUDENTS_SERVICE_URL=http://localhost:4101
TEACHERS_SERVICE_URL=http://localhost:4102
ENROLMENTS_SERVICE_URL=http://localhost:4103
FINANCE_SERVICE_URL=http://localhost:4104

# Timeout (ms) para chamadas aos serviços de contratos (default 4000).
CONTRACT_TIMEOUT_MS=4000

# --- API Client (@smartcampus/api-client) ---
G3_API_URL=http://localhost:4100
